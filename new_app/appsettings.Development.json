{
  // Development environment specific settings
  // These settings override the ones in appsettings.json
  "ConnectionStrings": {
    // Use local database for development
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=HotelReservationSystem;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  
  // Enable detailed error messages in development
  "DetailedErrors": true,
  
  // Enhanced logging for development
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information",
      // Enable sensitive data logging for EF Core in development only
      "Microsoft.EntityFrameworkCore": "Information"
    },
    // Enable debug output window logging
    "Debug": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft.Hosting": "Trace"
      }
    },
    // Configure console output
    "Console": {
      "LogLevel": {
        "Default": "Information"
      },
      "FormatterName": "json",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": true,
        "TimestampFormat": "HH:mm:ss ",
        "UseUtcTimestamp": false
      }
    }
  },
  
  // Identity settings specific for development
  "Identity": {
    "Password": {
      // Simplified password requirements for development
      "RequireDigit": true,
      "RequireLowercase": true,
      "RequireNonAlphanumeric": false,
      "RequireUppercase": false,
      "RequiredLength": 6,
      "RequiredUniqueChars": 1
    }
  },
  
  // Application Insights configuration for development
  "ApplicationInsights": {
    "ConnectionString": "InstrumentationKey=00000000-0000-0000-0000-000000000000"
  },
  
  // CORS policy settings for development
  "Cors": {
    "Origins": [
      "http://localhost:3000",
      "http://localhost:4200",
      "https://localhost:7184"
    ]
  },
  
  // Feature flags for development
  "FeatureManagement": {
    "EnableLiveChat": false,
    "EnableBetaFeatures": true,
    "ShowDebugInfo": true
  },
  
  // Cache configuration for development
  "Caching": {
    "AbsoluteExpirationSeconds": 60,
    "SlidingExpirationSeconds": 30
  }
}