        },
        "EntityFrameworkCore": {
          "Database": {
            "Command": "Information"
          },
          "Query": "Debug"
        }
      }
    },
  "AllowedHosts": "*",
  "DevEnvironment": {
    "UseInMemoryDatabase": false,
    "EnableSensitiveDataLogging": true,
    "EnableDetailedErrors": true
  }
