{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=HotelReservationSystem;Trusted_Connection=True;MultipleActiveResultSets=true",
    "LocalConnection": "Data Source=App_Data\\hotelreservation.db",
    "LocalHotel": "Data\\localdb;Database=HotelReservationSystem;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "DetailedErrors": true,
