{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=HotelReservationSystem;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "DetailedErrors": true,
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.Hosting.Lifetime": "Debug",
      "Microsoft.EntityFrameworkCore.Database.Command": "Debug",
      "Microsoft.EntityFrameworkCore": "Debug"
    },
    "Debug": {
      "LogLevel": {
        "Default": "Trace",
        "Microsoft.Hosting": "Debug"
      }
    },
    "Console": {
      "LogLevel": {
        "Default": "Debug"
      },
      "FormatterName": "json",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss.fff ",
        "UseUtcTimestamp": false,
        "JsonWriterOptions": {
          "Indented": true
        }
      }
    },
    "EventSource": {
      "LogLevel": {
        "Default": "Information"
      }
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Information"
      }
    }
  },
  "Identity": {
    "Password": {
      "RequireDigit": true,
      "RequireLowercase": true,
      "RequireNonAlphanumeric": false,
      "RequireUppercase": false,
      "RequiredLength": 6,
      "RequiredUniqueChars": 1
    },
    "SignIn": {
      "RequireConfirmedAccount": false,
      "RequireConfirmedEmail": false,
      "RequireConfirmedPhoneNumber": false
    },
    "Lockout": {
      "AllowedForNewUsers": true,
      "DefaultLockoutTimeSpanInMinutes": 5,
      "MaxFailedAccessAttempts": 5
    }
  },
  "ApplicationInsights": {
    "ConnectionString": "InstrumentationKey=00000000-0000-0000-0000-000000000000",
    "EnableAdaptiveSampling": false,
    "EnableDependencyTrackingTelemetryModule": true
  },
  "Cors": {
    "Origins": [
      "http://localhost:3000",
      "http://localhost:4200",
      "https://localhost:7184"
    ],
    "AllowCredentials": true
  },
  "FeatureManagement": {
    "EnableLiveChat": false,
    "EnableBetaFeatures": true,
    "ShowDebugInfo": true,
    "EnableSwagger": true,
    "EnableDevTools": true
  },
  "Caching": {
    "AbsoluteExpirationSeconds": 60,
    "SlidingExpirationSeconds": 30,
    "EnableDistributedCache": false
  },
  "EmailSettings": {
    "SmtpServer": "localhost",
    "SmtpPort": 25,
    "SenderEmail": "noreply@hotel.local",
    "SenderName": "Hotel Reservation System (Dev)",
    "UseSsl": false
  },
  "JwtSettings": {
    "Issuer": "hotel-api-dev",
    "Audience": "hotel-client-dev",
    "SecretKey": "devsecretsupersecretkeythatisverylongfordevenvironmentonly",
    "ExpiryInMinutes": 60
  }
}